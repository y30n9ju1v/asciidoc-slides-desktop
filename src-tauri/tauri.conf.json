{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsciiDoc Slides",
  "version": "0.1.0",
  "identifier": "com.asciidoc.slides",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AsciiDoc Slides",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["adoc", "asciidoc"],
        "name": "AsciiDoc Slide Deck",
        "role": "Editor",
        "mimeType": "text/asciidoc",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
